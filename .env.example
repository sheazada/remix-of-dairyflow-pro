# DairyFlow Pro — environment variables
# Copy this file to .env and fill in the real values.
# Never commit .env to version control.

# Supabase project URL (from Project Settings → API)
VITE_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_URL=https://your-project.supabase.co

# Supabase anon / publishable key (safe to ship to browsers; RLS-scoped)
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbG...your-anon-key
SUPABASE_PUBLISHABLE_KEY=eyJhbG...your-anon-key

# Supabase service-role key — SERVER ONLY. Never expose to the browser.
# Used by server functions and Edge Functions that bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=eyJhbG...your-service-role-key

# Sentry DSN (error monitoring; optional)
VITE_SENTRY_DSN=https://...@o....ingest.sentry.io/...

# Environment: "development" | "staging" | "production"
VITE_ENV=development
